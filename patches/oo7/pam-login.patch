+/// Acknowledge only after handling the complete request. The caller must not
+/// return before this acknowledgement, even if it can already write the socket.
+fn handle_request(listener: UnixListener) -> (JoinHandle<Vec<u8>>, Arc<AtomicBool>) {
+    listener.set_nonblocking(true).unwrap();
+    let completed = Arc::new(AtomicBool::new(false));
+    let handled = completed.clone();
+    let server = thread::spawn(move || {
+        let deadline = Instant::now() + Duration::from_secs(8);
+        let mut stream = loop {
+            match listener.accept() {
+                Ok((stream, _)) => break stream,
+                Err(e) if e.kind() == io::ErrorKind::WouldBlock && Instant::now() < deadline => {
+                    thread::sleep(Duration::from_millis(10));
+                }
+                Err(e) => panic!("PAM did not deliver its request: {e}"),
+            }
+        };
+        stream
+            .set_read_timeout(Some(Duration::from_secs(8)))
+            .unwrap();
+        let mut bytes = Vec::new();
+        stream.read_to_end(&mut bytes).unwrap();
+        let (length, message) = bytes.split_at(4);
+        assert_eq!(
+            u32::from_le_bytes(length.try_into().unwrap()) as usize,
+            message.len()
+        );
+        handled.store(true, Ordering::SeqCst);
+        stream.write_all(&[0]).unwrap();
+        message.to_vec()
+    });
+    (server, completed)
 }
 
