+    pub fn with_unlock_targets(mut self, objects: &[OwnedObjectPath]) -> Self {
+        let collection = self.collection().expect("Unlock requires a collection");
+        let path = collection.path().as_str();
+        self.single_collection = objects.iter().all(|object| {
+            object.as_str() == path
+                || object
+                    .as_str()
+                    .strip_prefix(path)
+                    .is_some_and(|suffix| suffix.starts_with('/'))
+        });
+        self
+    }
+
+    /// Complete a queued unlock without retaining or asking for the password
+    /// again when another request has already unlocked its collection.
+    pub async fn complete_if_unlocked(&self) -> Result<bool, ServiceError> {
+        if self.role != PromptRole::Unlock
+            || !self.single_collection
+            || self
+                .collection()
+                .expect("Unlock requires a collection")
+                .is_locked()
+                .await
+        {
+            return Ok(false);
+        }
+        self.complete_action(None).await?;
+        Ok(true)
+    }
+
+    async fn complete_action(&self, secret: Option<Secret>) -> Result<(), ServiceError> {
+        let action = self
+            .take_action()
+            .await
+            .ok_or_else(|| custom_service_error("Prompt action was already executed or not set"))?;
+        let signal_emitter = self.service.signal_emitter(self.path().to_owned())?;
+        match action.execute(secret).await {
+            Ok(result) => Prompt::completed(&signal_emitter, false, result).await?,
+            Err(err) => {
+                let result = zbus::zvariant::Value::new(Vec::<OwnedObjectPath>::new())
+                    .try_into_owned()
+                    .unwrap();
+                Prompt::completed(&signal_emitter, true, result).await?;
+                return Err(err);
+            }
+        }
+        Ok(())
+    }
