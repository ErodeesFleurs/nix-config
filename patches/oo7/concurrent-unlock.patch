+#[tokio::test]
+async fn queued_unlocks_keep_independent_cancellation() -> Result<(), Box<dyn std::error::Error>> {
+    let setup = TestServiceSetup::plain_session(true).await?;
+    let collection = setup.default_collection().await?;
+    let path: super::OwnedObjectPath = collection.inner().path().to_owned().into();
+    setup.lock_collection(collection).await?;
+
+    let (_, first) = setup.server.unlock(vec![path.clone()]).await?;
+    let (_, second) = setup.server.unlock(vec![path.clone()]).await?;
+    let (_, queued) = setup.server.unlock(vec![path.clone()]).await?;
+    assert_ne!(first, second);
+    assert_ne!(second, queued);
+
+    let first_prompt = oo7::dbus::api::Prompt::new(&setup.client_conn, first.clone())
+        .await?
+        .unwrap();
+    first_prompt.dismiss().await?;
+    assert!(setup.server.prompt(&first).await.is_none());
+
+    let second_prompt = setup.server.prompt(&second).await.unwrap();
+    assert!(!second_prompt.complete_if_unlocked().await?);
+    assert!(
+        second_prompt
+            .on_unlock_collection(setup.keyring_secret.clone())
+            .await?
+    );
+    assert!(!collection.is_locked().await?);
+
+    let queued_prompt = setup.server.prompt(&queued).await.unwrap();
+    assert!(queued_prompt.complete_if_unlocked().await?);
+    assert!(!collection.is_locked().await?);
+    Ok(())
+}
+
+#[tokio::test]
+async fn queued_unlock_does_not_skip_other_collection() -> Result<(), Box<dyn std::error::Error>> {
+    let setup = TestServiceSetup::plain_session(true).await?;
+    for collection in &setup.collections {
+        setup.lock_collection(collection).await?;
+    }
+    let paths = setup
+        .collections
+        .iter()
+        .map(|collection| collection.inner().path().to_owned().into())
+        .collect();
+    let (_, prompt_path) = setup.server.unlock(paths).await?;
+    let prompt = setup.server.prompt(&prompt_path).await.unwrap();
+    let collection = prompt.collection().unwrap();
+    collection
+        .set_locked(false, setup.keyring_secret.clone())
+        .await?;
+    assert!(!prompt.complete_if_unlocked().await?);
+    assert!(
+        setup
+            .collections
+            .iter()
+            .any(|other| other.inner().path() != collection.path())
+    );
+    Ok(())
+}
