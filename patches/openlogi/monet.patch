+//! Live, last-good Monet snapshots shared by both GPUI processes.
+
+use std::{
+    collections::BTreeSet,
+    path::{Path, PathBuf},
+    rc::Rc,
+    sync::{Arc, RwLock, mpsc},
+    time::Duration,
+};
+
+use anyhow::{Context as _, Result, bail};
+use gpui::{App, Global};
+use gpui_component::{ThemeConfig, ThemeMode, ThemeRegistry, ThemeSet};
+use notify::{EventKind, RecursiveMode, Watcher as _};
+use serde::Deserialize;
+
+/// Name of the generated light variant.
+pub const LIGHT: &str = "Monet MD3 Light";
+/// Name of the generated dark variant.
+pub const DARK: &str = "Monet MD3 Dark";
+
+#[derive(Debug, Deserialize)]
+struct Document {
+    appearance: ThemeMode,
+    #[serde(flatten)]
+    themes: ThemeSet,
+}
+
+struct Snapshot {
+    appearance: ThemeMode,
+    light: Rc<ThemeConfig>,
+    dark: Rc<ThemeConfig>,
+}
+impl Global for Snapshot {}
+
+/// Look up the current generated variant, independently of the registry's immutable entries.
+/// Kit's `load_themes_from_str` inserts only unseen names; retaining live configs here
+/// prevents wallpaper updates from silently continuing to use the first palette.
+#[must_use]
+pub fn config(name: &str, cx: &App) -> Option<Rc<ThemeConfig>> {
+    let snapshot = cx.try_global::<Snapshot>()?;
+    match name {
+        LIGHT => Some(Rc::clone(&snapshot.light)),
+        DARK => Some(Rc::clone(&snapshot.dark)),
+        _ => None,
+    }
+}
+
+/// The system mode published atomically with the palette, if a valid file has loaded.
+#[must_use]
+pub fn appearance(cx: &App) -> Option<ThemeMode> {
+    cx.try_global::<Snapshot>().map(|snapshot| snapshot.appearance)
+}
+
+fn theme_path() -> Option<PathBuf> {
+    std::env::var_os("XDG_CONFIG_HOME")
+        .filter(|path| !path.is_empty())
+        .map(PathBuf::from)
+        .or_else(|| std::env::var_os("HOME").map(|home| PathBuf::from(home).join(".config")))
+        .map(|config| config.join("openlogi/monet.json"))
+}
+
+fn parse_document(content: &[u8]) -> Result<Document> {
+    let document: Document = serde_json::from_slice(content)?;
+    for (name, mode) in [(LIGHT, ThemeMode::Light), (DARK, ThemeMode::Dark)] {
+        if !document
+            .themes
+            .themes
+            .iter()
+            .any(|theme| theme.name == name && theme.mode == mode)
+        {
+            bail!("Monet theme must contain {name} in {mode:?} mode");
+        }
+    }
+    Ok(document)
+}
+
+fn read_document(path: &Path) -> Result<Document> {
+    parse_document(&std::fs::read(path)?)
+        .with_context(|| format!("invalid Monet theme: {}", path.display()))
+}
+
+fn publish(document: Document, cx: &mut App) {
+    // Keep both names in the normal Appearance picker without replacing bundled themes.
+    // The live lookup above takes precedence over these initial registry entries.
+    // Touching the registry triggers Kit's observer, which re-applies its stored
+    // configs. Register only once, otherwise that observer can overwrite the
+    // live snapshot with the first palette on each subsequent wallpaper change.
+    let registered = [LIGHT, DARK]
+        .iter()
+        .all(|name| ThemeRegistry::global(cx).themes().contains_key(*name));
+    if !registered {
+        if let Ok(json) = serde_json::to_string(&document.themes) {
+            if let Err(error) = ThemeRegistry::global_mut(cx).load_themes_from_str(&json) {
+                tracing::warn!(%error, "could not register Monet themes");
+            }
+        }
+    }
+    let mut light = None;
+    let mut dark = None;
+    for theme in document.themes.themes {
+        if theme.name == LIGHT && theme.mode == ThemeMode::Light {
+            light = Some(Rc::new(theme));
+        } else if theme.name == DARK && theme.mode == ThemeMode::Dark {
+            dark = Some(Rc::new(theme));
+        }
+    }
+    if let (Some(light), Some(dark)) = (light, dark) {
+        cx.set_global(Snapshot {
+            appearance: document.appearance,
+            light,
+            dark,
+        });
+    }
+}
+
+struct WatchScope {
+    directories: BTreeSet<PathBuf>,
+    affected: BTreeSet<PathBuf>,
+}
+
+fn include_resolution_path(path: &Path, affected: &mut BTreeSet<PathBuf>) {
+    for ancestor in path.ancestors() {
+        if ancestor.parent().is_some() {
+            affected.insert(ancestor.to_path_buf());
+        }
+    }
+}
+
+fn watch_scope(path: &Path) -> WatchScope {
+    let mut affected = BTreeSet::new();
+    let mut paths = vec![path.to_path_buf()];
+    if let Some(home) = std::env::var_os("HOME") {
+        paths.push(PathBuf::from(home).join(".local/share/themes/current/openlogi/monet.json"));
+    }
+    // Track exact directory entries along both lexical and resolved paths. A
+    // watched ancestor is not a subtree interest: unrelated siblings in HOME,
+    // .config, .local or the theme directory must never trigger a reload.
+    for path in &paths {
+        include_resolution_path(path, &mut affected);
+        for ancestor in path.ancestors() {
+            if let Ok(resolved) = ancestor.canonicalize() {
+                include_resolution_path(&resolved, &mut affected);
+            } else if let (Some(parent), Some(name)) = (ancestor.parent(), ancestor.file_name()) {
+                if let Ok(parent) = parent.canonicalize() {
+                    include_resolution_path(&parent.join(name), &mut affected);
+                }
+            }
+        }
+    }
+    let directories = affected
+        .iter()
+        .filter_map(|path| path.canonicalize().ok())
+        .filter(|path| path.is_dir())
+        .collect();
+    WatchScope { directories, affected }
+}
+
+fn event_affects_theme(event: &notify::Event, affected: &BTreeSet<PathBuf>) -> bool {
+    event.need_rescan()
+        || (matches!(
+            event.kind,
+            EventKind::Any | EventKind::Create(_) | EventKind::Modify(_) | EventKind::Remove(_)
+        ) && event.paths.iter().any(|path| affected.contains(path)))
+}
+
+fn read_changed_document(path: &Path, previous: &mut Option<Vec<u8>>) -> Result<Option<Document>> {
+    let content = std::fs::read(path)?;
+    if previous.as_deref() == Some(content.as_slice()) {
+        return Ok(None);
+    }
+    let document = parse_document(&content)
+        .with_context(|| format!("invalid Monet theme: {}", path.display()))?;
+    *previous = Some(content);
+    Ok(Some(document))
+}
+
+/// Load at startup and install a native directory watcher. `changed` applies the
+/// snapshot to the consumer's normal appearance owner; it never mutates settings.
+/// I/O, parsing and debounce happen on one sleeping worker, not in a render or
+/// the GPUI thread. Failed/partial replacements retain the previous valid pair.
+pub fn install(cx: &mut App, changed: fn(&mut App)) {
+    let Some(path) = theme_path() else {
+        return;
+    };
+    match read_document(&path) {
+        Ok(document) => publish(document, cx),
+        Err(error) => tracing::debug!(%error, "Monet theme not available at startup"),
+    }
+    let (snapshots, mut receiver) = tokio::sync::mpsc::channel(1);
+    let worker = std::thread::Builder::new()
+        .name("openlogi-monet".into())
+        .spawn(move || {
+            let (events, pending) = mpsc::sync_channel(1);
+            let affected = Arc::new(RwLock::new(BTreeSet::new()));
+            let callback_affected = Arc::clone(&affected);
+            let mut watcher = match notify::recommended_watcher(
+                move |event: notify::Result<notify::Event>| match event {
+                    Ok(event) => {
+                        let interested = event_affects_theme(
+                            &event,
+                            &callback_affected.read().unwrap_or_else(|error| error.into_inner()),
+                        );
+                        if interested {
+                            let _ = events.try_send(());
+                        }
+                    }
+                    Err(error) => {
+                        tracing::warn!(%error, "Monet watcher error");
+                        let _ = events.try_send(());
+                    }
+                },
+            ) {
+                Ok(watcher) => watcher,
+                Err(error) => {
+                    tracing::warn!(%error, "could not start Monet watcher");
+                    return;
+                }
+            };
+            let mut watched: BTreeSet<PathBuf> = BTreeSet::new();
+            let mut previous = None;
+            loop {
+                // Re-arm after every event, even if paths compare equal: an atomic
+                // directory replacement can invalidate the watch at the same name.
+                for directory in &watched {
+                    let _ = watcher.unwatch(directory);
+                }
+                let scope = watch_scope(&path);
+                *affected.write().unwrap_or_else(|error| error.into_inner()) = scope.affected;
+                watched = scope.directories;
+                for directory in &watched {
+                    if let Err(error) = watcher.watch(directory, RecursiveMode::NonRecursive) {
+                        tracing::warn!(%error, path = %directory.display(), "could not watch Monet directory");
+                    }
+                }
+                // Registration precedes the read, closing the startup/re-arm race.
+                match read_changed_document(&path, &mut previous) {
+                    Ok(Some(document)) => {
+                        if snapshots.blocking_send(document).is_err() {
+                            break;
+                        }
+                    }
+                    Ok(None) => {}
+                    Err(error) => tracing::debug!(%error, "retaining last-good Monet theme"),
+                }
+                if pending.recv().is_err() {
+                    break;
+                }
+                // One bounded burst delay, not polling; writes arriving during this
+                // read are queued and cause another reconciliation.
+                std::thread::sleep(Duration::from_millis(75));
+                while pending.try_recv().is_ok() {}
+            }
+        });
+    if let Err(error) = worker {
+        tracing::warn!(%error, "could not spawn Monet watcher");
+    }
+    cx.spawn(async move |cx| {
+        while let Some(document) = receiver.recv().await {
+            cx.update(|cx| {
+                publish(document, cx);
+                changed(cx);
+                cx.refresh_windows();
+            });
+        }
+    })
+    .detach();
+}
