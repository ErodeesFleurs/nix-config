+        for content in [
+            br#"{"appearance":"dark","themes":[]}"#.as_slice(),
+            br#"{"appearance":"light","themes":[{"name":"Monet MD3 Light","mode":"dark"},{"name":"Monet MD3 Dark","mode":"dark"}]}"#.as_slice(),
+            br#"{"themes":[{"name":"Monet MD3 Light","mode":"light"},{"name":"Monet MD3 Dark","mode":"dark"}]}"#.as_slice(),
+            br#"{"appearance":"dark","themes": ["#.as_slice(),
+        ] {
+            parse_document(content).unwrap_err();
+        }
