+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[gpui::test]
+    fn live_reload_updates_consumed_colors_and_system_mode(cx: &mut gpui::TestAppContext) {
+        use gpui_component::Theme;
+
+        let initial = br##"{
+            "appearance": "light",
+            "themes": [
+                {"name":"Monet MD3 Light","mode":"light","colors":{
+                    "primary.background":"#3456ab","accent.background":"#cdd8ef","accent.foreground":"#123456"
+                }},
+                {"name":"Monet MD3 Dark","mode":"dark","colors":{
+                    "primary.background":"#abc8ef","accent.background":"#234567","accent.foreground":"#cdefab"
+                }}
+            ]
+        }"##;
+        let replacement = br##"{
+            "appearance": "dark",
+            "themes": [
+                {"name":"Monet MD3 Light","mode":"light","colors":{
+                    "primary.background":"#456712","accent.background":"#d8efcd","accent.foreground":"#345612"
+                }},
+                {"name":"Monet MD3 Dark","mode":"dark","colors":{
+                    "primary.background":"#c8efab","accent.background":"#456723","accent.foreground":"#efabcd"
+                }}
+            ]
+        }"##;
+        cx.update(|cx| {
+            gpui_component::init(cx);
+            publish(parse_document(initial).unwrap(), cx);
+            crate::color::apply(None, cx);
+            assert_eq!(Theme::global(cx).mode, ThemeMode::Light);
+            let first = crate::color::palette(cx);
+            assert_eq!(first.accent, gpui::Hsla::from(gpui::rgb(0x3456ab)));
+            assert_eq!(first.selected, gpui::Hsla::from(gpui::rgb(0xcdd8ef)));
+            assert_eq!(first.selected_foreground, gpui::Hsla::from(gpui::rgb(0x123456)));
+
+            publish(parse_document(replacement).unwrap(), cx);
+            crate::color::apply(None, cx);
+            assert_eq!(Theme::global(cx).mode, ThemeMode::Dark);
+            let dark = crate::color::palette(cx);
+            assert_eq!(dark.accent, gpui::Hsla::from(gpui::rgb(0xc8efab)));
+            assert_eq!(dark.selected, gpui::Hsla::from(gpui::rgb(0x456723)));
+            assert_eq!(dark.selected_foreground, gpui::Hsla::from(gpui::rgb(0xefabcd)));
+
+            // The explicit light slot must also consume the replacement, not
+            // the initial config still retained in Kit's insert-only registry.
+            Theme::change(ThemeMode::Light, None, cx);
+            let light = crate::color::palette(cx);
+            assert_eq!(light.accent, gpui::Hsla::from(gpui::rgb(0x456712)));
+            assert_eq!(light.selected, gpui::Hsla::from(gpui::rgb(0xd8efcd)));
+            assert_eq!(light.selected_foreground, gpui::Hsla::from(gpui::rgb(0x345612)));
+        });
+    }
+
+    #[test]
+    fn watcher_ignores_siblings_but_tracks_replaced_resolution_entries() {
+        let mut affected = BTreeSet::new();
+        include_resolution_path(Path::new("/home/test/.config/openlogi/monet.json"), &mut affected);
+        include_resolution_path(Path::new("/home/test/.local/share/themes/current/openlogi/monet.json"), &mut affected);
+        include_resolution_path(Path::new("/home/test/.local/share/themes/light/openlogi/monet.json"), &mut affected);
+        for path in [
+            "/home/test/download.txt",
+            "/home/test/.config/zed/settings.json",
+            "/home/test/.config/openlogi/config.toml",
+            "/home/test/.local/share/themes/current-backup",
+            "/home/test/.local/share/themes/light/openlogi/other.json",
+        ] {
+            let event = notify::Event::new(EventKind::Create(notify::event::CreateKind::Any))
+                .add_path(PathBuf::from(path));
+            assert!(!event_affects_theme(&event, &affected), "unrelated sibling: {path}");
+        }
+        for path in [
+            "/home/test/.config/openlogi",
+            "/home/test/.config/openlogi/monet.json",
+            "/home/test/.local/share/themes/current",
+            "/home/test/.local/share/themes/light/openlogi",
+            "/home/test/.local/share/themes/light/openlogi/monet.json",
+        ] {
+            let event = notify::Event::new(EventKind::Modify(notify::event::ModifyKind::Name(notify::event::RenameMode::Both)))
+                .add_path(PathBuf::from("/home/test/unrelated-tmp"))
+                .add_path(PathBuf::from(path));
+            assert!(event_affects_theme(&event, &affected), "resolution entry: {path}");
+        }
+        let rescan = notify::Event::new(EventKind::Other).set_flag(notify::event::Flag::Rescan);
+        assert!(event_affects_theme(&rescan, &affected));
+    }
