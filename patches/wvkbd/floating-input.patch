+
+static void
+drag_motion(int x, int y)
+{
+    int old_x = floating_x, old_y = floating_y;
+    /* Niri pins grab coordinates to the surface origin at button/touch-down. */
+    floating_x = drag_start_x + x - grab_x;
+    floating_y = drag_start_y + y - grab_y;
+    clamp_position();
+    if (floating_x != old_x || floating_y != old_y) {
+        set_position();
+        wl_surface_commit(draw_surf.surf);
+    }
+}
+
+static bool
+header_press(int x, int y, enum drag_source source)
+{
+    if (!keyboard.floating || x < 0 || x >= keyboard.w ||
+        y < 0 || y >= FLOATING_HEADER_HEIGHT)
+        return false;
+    if (x >= keyboard.w - 56 && x < keyboard.w - FLOATING_PADDING) {
+        run_display = false;
+    } else {
+        dragging = source;
+        grab_x = x;
+        grab_y = y;
+        drag_start_x = floating_x;
+        drag_start_y = floating_y;
+    }
+    return true;
+}
+
+static void
+output_geometry(void *data, struct wl_output *wl_output, int32_t x, int32_t y,
+                int32_t physical_width, int32_t physical_height, int32_t subpixel,
+                const char *make, const char *model, int32_t transform)
+{
+    struct output *output = data;
+    if (output->transform != transform) {
+        output->transform = transform;
+        output->changed = true;
+    }
+}
+
+static void
+output_mode(void *data, struct wl_output *wl_output, uint32_t flags,
+            int32_t width, int32_t height, int32_t refresh)
+{
+    struct output *output = data;
+    if ((flags & WL_OUTPUT_MODE_CURRENT) &&
+        (output->width != width || output->height != height)) {
+        output->width = width;
+        output->height = height;
+        output->changed = true;
+    }
+}
+
+static void
+output_scale(void *data, struct wl_output *wl_output, int32_t scale)
+{
+    struct output *output = data;
+    if (output->scale != scale) {
+        output->scale = scale;
+        output->changed = true;
+    }
+}
+
+static void
+output_done(void *data, struct wl_output *wl_output)
+{
+    struct output *output = data;
+    if (keyboard.floating && output == current_output && output->changed)
+        dimensions_pending = true;
+    output->changed = false;
+}
