+static void
+set_floating_input_region(void)
+{
+    struct wl_region *region = wl_compositor_create_region(compositor);
+    const int radius = FLOATING_PADDING;
+    wl_region_add(region, 0, radius, keyboard.w, keyboard.h - radius * 2);
+    for (int y = 0; y < radius; ++y) {
+        int inset = radius;
+        while (inset > 0 &&
+               (radius - inset) * (radius - inset) +
+               (radius - y - 1) * (radius - y - 1) < radius * radius)
+            --inset;
+        wl_region_add(region, inset, y, keyboard.w - inset * 2, 1);
+        wl_region_add(region, inset, keyboard.h - y - 1, keyboard.w - inset * 2, 1);
+    }
+    wl_surface_set_input_region(draw_surf.surf, region);
+    wl_region_destroy(region);
+}
