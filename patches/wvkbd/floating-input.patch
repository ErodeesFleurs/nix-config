+
+static void
+clamp_position(void)
+{
+    int max_x = available_width > keyboard.w ? available_width - keyboard.w : 0;
+    int max_y = available_height > keyboard.h ? available_height - keyboard.h : 0;
+    if (floating_x < 0) floating_x = 0;
+    if (floating_y < 0) floating_y = 0;
+    if (floating_x > max_x) floating_x = max_x;
+    if (floating_y > max_y) floating_y = max_y;
+}
