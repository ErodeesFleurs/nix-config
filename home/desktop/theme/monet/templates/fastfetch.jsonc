{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": ": ",
    "color": "@primary@"
  },
  "logo": {
    "type": "file",
    "source": "$(ls @home_dir@/.config/fastfetch/logo/* | shuf -n 1)",
    "color": {
      "1": "@primary@",
      "2": "@tertiary@"
    }
  },
  // Native keys retain GPU indices and disk mountpoints; short headers avoid a fixed-width frame.
  // Only show uptime: the tmpfs root's birth time is not the OS installation date.
  "modules": [
    {
      "type": "custom",
      "format": "── Hardware ──"
    },
    { "type": "host" },
    { "type": "cpu" },
    { "type": "gpu", "detectionMethod": "pci" },
    { "type": "board" },
    { "type": "display" },
    { "type": "memory" },
    { "type": "disk" },
    "break",
    {
      "type": "custom",
      "format": "── Software ──"
    },
    { "type": "os" },
    { "type": "kernel", "format": "{1} {2}" },
    { "type": "wm" },
    { "type": "shell" },
    { "type": "packages" },
    { "type": "terminalfont" },
    "break",
    {
      "type": "custom",
      "format": "── Runtime ──"
    },
    { "type": "processes" },
    { "type": "uptime", "keyColor": "@primary@" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
